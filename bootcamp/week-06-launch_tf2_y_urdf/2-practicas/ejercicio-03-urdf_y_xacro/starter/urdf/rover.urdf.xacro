<?xml version="1.0"?>
<!--
  Ejercicio 03, Semana 06: un robot móvil pequeño de dos ruedas motrices y
  una rueda loca. Unidades SI: metros, radianes, kilogramos (REP 103).
  Ejes de cada marco: x hacia delante, y a la izquierda, z hacia arriba.
-->
<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Medidas en un solo sitio: cambiar una no obliga a buscarla por el archivo. -->
  <xacro:property name="chassis_x" value="0.40"/>
  <xacro:property name="chassis_y" value="0.30"/>
  <xacro:property name="chassis_z" value="0.10"/>
  <xacro:property name="chassis_mass" value="5.0"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.3"/>

  <!--
    Inercia de una caja y de un cilindro macizos (fórmulas de la teoría 05).
    Gazebo las necesita en la Semana 08; check_urdf ya comprueba que existan.
  -->
  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (y*y + z*z) / 12}" ixy="0" ixz="0"
               iyy="${mass * (x*x + z*z) / 12}" iyz="0"
               izz="${mass * (x*x + y*y) / 12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (3*radius*radius + length*length) / 12}" ixy="0" ixz="0"
               iyy="${mass * (3*radius*radius + length*length) / 12}" iyz="0"
               izz="${mass * radius*radius / 2}"/>
    </inertial>
  </xacro:macro>

  <!--
    ============================================
    PASO 1: el chasis y el láser
    ============================================
    base_link es el marco del cuerpo del robot: su origen está en el centro
    de la caja. laser_link cuelga de base_link con una articulación fixed
    (no se mueve): robot_state_publisher la publicará en /tf_static.
    Para el Paso 1, borra las dos líneas marcadas con "(borra esta línea)".
  -->
  <!-- PASO 1 (borra esta línea)
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_x} ${chassis_y} ${chassis_z}"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_x} ${chassis_y} ${chassis_z}"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="${chassis_mass}" x="${chassis_x}" y="${chassis_y}" z="${chassis_z}"/>
  </link>

  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </visual>
    <xacro:cylinder_inertial mass="0.1" radius="0.03" length="0.04"/>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.15 0 ${chassis_z / 2 + 0.03}" rpy="0 0 0"/>
  </joint>
  PASO 1 (borra esta línea) -->

  <!--
    ============================================
    PASO 2: las ruedas con una macro
    ============================================
    Las dos ruedas son iguales salvo el nombre y el lado: una macro las
    escribe una vez. side es 1 (izquierda, +y) o -1 (derecha, -y). El
    cilindro de URDF tiene su eje en z; rpy="-pi/2 0 0" lo tumba para que
    su eje quede en y, el eje de giro de la rueda.
    Para el Paso 2, borra las dos líneas marcadas con "(borra esta línea)".
  -->
  <!-- PASO 2 (borra esta línea)
  <xacro:macro name="wheel" params="prefix side">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0.08 ${side * (chassis_y / 2 + wheel_width / 2)} ${-chassis_z / 2}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" side="1"/>
  <xacro:wheel prefix="right" side="-1"/>

  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${wheel_radius / 2}"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${wheel_radius / 2}"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="0.05" x="${wheel_radius}" y="${wheel_radius}" z="${wheel_radius}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.14 0 ${-chassis_z / 2 - wheel_radius / 2}" rpy="0 0 0"/>
  </joint>
  PASO 2 (borra esta línea) -->

</robot>
