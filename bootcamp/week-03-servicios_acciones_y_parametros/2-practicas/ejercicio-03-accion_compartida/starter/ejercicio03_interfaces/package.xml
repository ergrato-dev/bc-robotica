<?xml version="1.0"?>
<package format="3">
  <name>ejercicio03_interfaces</name>
  <version>0.1.0</version>
  <description>Ejercicio 03 — acción MoveDistance compartida por Python y C++ (Semana 03)</description>
  <maintainer email="ergrato-dev@example.com">bc-robotica</maintainer>
  <license>CC-BY-NC-SA-4.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Las acciones se apoyan en los tipos de action_msgs (GoalInfo, GoalStatus...). -->
  <depend>action_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
